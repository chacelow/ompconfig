{
  "name": "observational-memory",
  "version": "0.1.0",
  "description": "Observational memory for pi — tiered, subprocess-backed memory: parallel observers feed a branch-local ledger buffer; a consolidator (Phase B) promotes the oldest observations into durable .memory/ topic files.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-agent-core": "*",
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-tui": "*"
  },
  "devDependencies": {
    "@oh-my-pi/pi-agent-core": "^0.74.0",
    "@oh-my-pi/pi-ai": "^0.74.0",
    "@oh-my-pi/pi-coding-agent": "^0.74.0",
    "@oh-my-pi/pi-tui": "^0.74.0",
    "@types/node": "^22.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.6.0",
    "vitest": "^4.1.5"
  }
}
